; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Ball Escape: Ultra Kinetic"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[display]

; ⚠️ 本工程有三个不同的「分辨率」，别混：
;   viewport_*         逻辑设计尺寸（画布的尺子）。FONT_* / SIDEBAR_WIDTH 这些
;                      写死的像素都以它为基准 —— 改它不会让 UI 跟着变大，
;                      只会改变「一个像素代表多少内容」。
;   window_*_override  预览窗口大小（只影响屏幕，不进成片）。
;   ..._override.movie 出片分辨率。canvas_items 拉伸模式下由它决定；viewport
;                      模式下由 viewport_* 决定。实测 `--resolution` 对出片
;                      **无效**（只改窗口，还会被显示器裁掉）。
; 两档位（1080×1920 / 4K 竖屏 2160×3840）靠 override.cfg 切，见 README
; 「两档出片分辨率」一节；模板在 tools/tier_4k.cfg。
window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960
window/size/window_width_override.movie=1080
window/size/window_height_override.movie=1920
window/stretch/mode="canvas_items"

[editor]

movie_writer/movie_file="D:/lg/else/videos-godot/godot-ballgame/captures/ballgame2.ogv"

[layer_names]

2d_physics/layer_1="ball"
2d_physics/layer_2="ring"
2d_physics/layer_3="bounds"

[physics]

common/physics_jitter_fix.movie=0.0

[rendering]

; 2D 抗锯齿：**必须靠 MSAA**。`Polygon2D` 的 `antialiased` 属性在本引擎版本里是
; 空操作（实测改它前后渲染出的 PNG 逐字节相同），`Line2D.antialiased` 同样无效；
; 官方 2D 抗锯齿文档也写明 Polygon2D 这类节点「don't feature an antialiased property」，
; 要用 2D MSAA 代替。
; 取值：0=关，1=2x，2=4x，3=8x。实测圆环边缘软度 6.63(0) → 8.76(4x)，8x 无额外收益。
; ⚠️ 仅工程启动时读取一次；运行时要用 `Viewport.msaa_2d` 改。
; ⚠️ 仅 Forward+ / Mobile 支持，Compatibility 渲染器无效。
anti_aliasing/quality/msaa_2d=2
